# Local development settings. Copy to .env (git-ignored) and fill in.
# Nothing in this file is needed to use the integration - only for development scripts.

# The iCON controller used for recording test fixtures (scripts/record_fixtures.py)
ICON_HOST=192.0.2.10
# 12-digit system ID; leave empty to discover it (firmware >= 1079)
ICON_SYSID=

# The Home Assistant instance scripts/deploy_ha.py installs the integration on
HA_URL=http://homeassistant.local:8123
HA_USER=
HA_PASSWORD=
# Slug of the FTP add-on used for the upload (Settings -> Add-ons -> FTP -> URL)
HA_FTP_ADDON=a0d7b954_ftp

# Development Home Assistant (scripts/dev-ha.sh creates the user on first start)
DEV_HA_URL=http://localhost:8123
DEV_HA_USER=dev
DEV_HA_PASSWORD=
